# Built-in Manus LLM runtime injects these in server environments.
# Never commit real values or expose them to browser code.
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
BUILT_IN_FORGE_API_KEY=
LLM_MODEL=gpt-6.1-sol
PORT=3000

# Free local open-weight rewrite route via Ollama. No paid API key required.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODELS=qwen3:8b,phi4:latest,smollm2:1.7b,deepseek-coder-v2:lite
LOCAL_LLM_TIMEOUT_MS=90000
